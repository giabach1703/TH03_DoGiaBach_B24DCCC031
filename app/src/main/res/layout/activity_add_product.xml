<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F3F6F5"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Thêm sản phẩm" android:textSize="22sp" android:textColor="#FFFFFF" android:background="#00796B" android:padding="18dp" android:textStyle="bold"/><ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tên sản phẩm" android:textSize="14sp" android:textColor="#20332F" android:textStyle="bold" android:layout_marginBottom="5dp"/><EditText android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Ví dụ: Tai nghe Bluetooth" android:inputType="text" android:background="@drawable/wh_field" android:padding="12dp" android:layout_marginBottom="12dp" android:minHeight="48dp" android:id="@+id/name"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Giá bán (VNĐ)" android:textSize="14sp" android:textColor="#20332F" android:textStyle="bold" android:layout_marginBottom="5dp"/><EditText android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Ví dụ: 250000" android:inputType="number" android:background="@drawable/wh_field" android:padding="12dp" android:layout_marginBottom="12dp" android:minHeight="48dp" android:id="@+id/price"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Số lượng" android:textSize="14sp" android:textColor="#20332F" android:textStyle="bold" android:layout_marginBottom="5dp"/><EditText android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Ví dụ: 10" android:inputType="number" android:background="@drawable/wh_field" android:padding="12dp" android:layout_marginBottom="12dp" android:minHeight="48dp" android:id="@+id/quantity"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Loại sản phẩm" android:textSize="14sp" android:textColor="#20332F" android:textStyle="bold" android:layout_marginBottom="5dp"/><Spinner android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/wh_field" android:layout_marginBottom="12dp" android:id="@+id/category"/><Switch android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Đang kinh doanh" android:checked="true" android:minHeight="48dp" android:id="@+id/active"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mô tả" android:textSize="14sp" android:textColor="#20332F" android:textStyle="bold" android:layout_marginBottom="5dp"/><EditText android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nhập mô tả" android:inputType="textMultiLine" android:background="@drawable/wh_field" android:padding="12dp" android:layout_marginBottom="12dp" android:minHeight="48dp" android:minLines="3" android:gravity="top" android:id="@+id/description"/><Button android:layout_width="match_parent" android:layout_height="52dp" android:text="Lưu sản phẩm" android:textColor="#FFFFFF" android:backgroundTint="#00796B" android:textAllCaps="false" android:id="@+id/save"/><Button android:layout_width="match_parent" android:layout_height="52dp" android:text="Quay lại" android:textColor="#FFFFFF" android:backgroundTint="#546E7A" android:textAllCaps="false" android:id="@+id/back"/></LinearLayout></ScrollView></LinearLayout>